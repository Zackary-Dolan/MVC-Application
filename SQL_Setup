

DROP DATABASE IF EXISTS Year4_Thesis;
CREATE DATABASE Year4_Thesis;
USE Year4_Thesis;

create table Student_Login(
	student_Id VARCHAR(30) PRIMARY KEY,
	student_password VARCHAR(30)
);

create table Professor_Login(
	professor_Id VARCHAR(30) PRIMARY KEY,
	professor_password VARCHAR(30)
);

create table Admin_Login(
	admin_Id VARCHAR(30) PRIMARY KEY,
	admin_Password VARCHAR(30)
);

CREATE TABLE Student (
    student_Id VARCHAR(30) PRIMARY KEY,
    first_name VARCHAR(30) NOT NULL,
    last_name VARCHAR(30) NOT NULL,
    age Int NOT NULL,
    gender VARCHAR(30),
    course_id VARCHAR(80) NOT NULL,
    course_Year INT NOT NULL
);

create table Course (
	course_id VARCHAR(30) PRIMARY KEY NOT NULL,
    classes_number INT NOT NULL,
    course_Duration INT NOT NULL,
    credits INT NOT NULL
);


create table Societies (
	society_name VARCHAR(30),
    upcoming_event_Society VARCHAR(30),
    society_head VARCHAR(30)
);
create table College_Events(
	event_Date VARCHAR(30),
    upcoming_event_Society VARCHAR(30),
    event_Location VARCHAR(30)
);

